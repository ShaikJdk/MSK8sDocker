pipeline {

    agent any
	
	tools {
        // This MUST match the exact Name you typed in Jenkins UI
        maven 'apache-maven-3.9.6' 
    }

    environment {
        IMAGE_NAME = "api-gateway1"
        IMAGE_TAG  = "latest"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Jar') {
    steps {
        dir('spring-cloud-apigateway1') {
            bat 'mvn clean package -DskipTests'
        }
    }
}

        stage('Build Docker Image') {
    steps {
        dir('spring-cloud-apigateway1') {
            bat 'docker build -t api-gateway1:latest .'
        }
    }
}

        stage('Deploy To Kubernetes') {
            steps {
                bat 'kubectl apply -f k8s/'
            }
        }

    }

    post {

        success {
            echo 'API Gateway deployed successfully'
        }

        failure {
            echo 'Build or deployment failed'
        }

    }
}